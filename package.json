{
  "name": "bachatt-bazaar-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",

    "server": "nodemon --spawn server/server.js",
    "client": "vite --config vite.config.js",

    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config client/vite.config.js",

    "start": "node server/server.js",

    "lint": "eslint .",

    "seed:categories": "node server/scripts/seedCategories.js"
  },

  "dependencies": {
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "lucide-react": "^1.8.0",
    "zod": "^4.3.6"
  },

  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  }
}