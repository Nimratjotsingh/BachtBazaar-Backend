{
  "info": {
    "_postman_id": "99g7e7e6-e7e3-5b7e-bbe1-7f050f51d5c5",
    "name": "BachtBazaar User Register + Login Flow (3-Step)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "User workflow: send-otp (phone only) → verify-otp → set-password → login"
  },
  "item": [
    {
      "name": "01 - Send OTP (Phone Only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{user_phone}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/send-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "send-otp"
          ]
        }
      }
    },
    {
      "name": "02 - Verify OTP (Firebase Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{firebase_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/verify-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "verify-otp"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.collectionVariables.set('user_token', json.token);",
              "  console.log('JWT Token saved:', json.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Set Password (Protected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"{{user_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/set-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "set-password"
          ]
        }
      }
    },
    {
      "name": "04 - Login User (Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"{{user_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.collectionVariables.set('user_token', json.token);",
              "  console.log('JWT Token saved:', json.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Login User (OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{firebase_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/login-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "login-otp"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "user_phone",
      "value": "1234567890"
    },
    {
      "key": "user_password",
      "value": "UserPass@123"
    },
    {
      "key": "firebase_token",
      "value": ""
    },
    {
      "key": "user_token",
      "value": ""
    }
  ]
}
